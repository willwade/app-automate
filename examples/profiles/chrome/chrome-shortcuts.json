{
  "new_tab": {
    "keys": "ctrl+t",
    "keys_macos": "cmd+t",
    "description": "Open new tab"
  },
  "close_tab": {
    "keys": "ctrl+w",
    "keys_macos": "cmd+w",
    "description": "Close current tab"
  },
  "new_window": {
    "keys": "ctrl+n",
    "keys_macos": "cmd+n",
    "description": "Open new window"
  },
  "new_incognito": {
    "keys": "ctrl+shift+n",
    "keys_macos": "cmd+shift+n",
    "description": "Open incognito window"
  },
  "reopen_tab": {
    "keys": "ctrl+shift+t",
    "keys_macos": "cmd+shift+t",
    "description": "Reopen last closed tab"
  },
  "url_bar": {
    "keys": "ctrl+l",
    "keys_macos": "cmd+l",
    "description": "Focus URL bar"
  },
  "find": {
    "keys": "ctrl+f",
    "keys_macos": "cmd+f",
    "description": "Find in page"
  },
  "find_next": {
    "keys": "ctrl+g",
    "keys_macos": "cmd+g",
    "description": "Find next match"
  },
  "find_prev": {
    "keys": "ctrl+shift+g",
    "keys_macos": "cmd+shift+g",
    "description": "Find previous match"
  },
  "reload": {
    "keys": "f5",
    "description": "Reload page"
  },
  "hard_reload": {
    "keys": "ctrl+shift+f5",
    "keys_macos": "cmd+shift+f5",
    "description": "Hard reload (clear cache)"
  },
  "back": {
    "keys": "alt+left",
    "keys_macos": "ctrl+left",
    "description": "Go back"
  },
  "forward": {
    "keys": "alt+right",
    "keys_macos": "ctrl+right",
    "description": "Go forward"
  },
  "bookmark": {
    "keys": "ctrl+d",
    "keys_macos": "cmd+d",
    "description": "Bookmark current page"
  },
  "bookmark_manager": {
    "keys": "ctrl+shift+o",
    "keys_macos": "cmd+shift+o",
    "description": "Open bookmark manager"
  },
  "history": {
    "keys": "ctrl+h",
    "keys_macos": "cmd+h",
    "description": "Show history"
  },
  "downloads": {
    "keys": "ctrl+j",
    "keys_macos": "cmd+j",
    "description": "Show downloads"
  },
  "zoom_in": {
    "keys": "ctrl+plus",
    "keys_macos": "cmd+plus",
    "description": "Zoom in"
  },
  "zoom_out": {
    "keys": "ctrl+minus",
    "keys_macos": "cmd+minus",
    "description": "Zoom out"
  },
  "zoom_reset": {
    "keys": "ctrl+0",
    "keys_macos": "cmd+0",
    "description": "Reset zoom"
  },
  "devtools": {
    "keys": "f12",
    "description": "Toggle developer tools"
  },
  "print": {
    "keys": "ctrl+p",
    "keys_macos": "cmd+p",
    "description": "Print page"
  },
  "save_page": {
    "keys": "ctrl+s",
    "keys_macos": "cmd+s",
    "description": "Save page"
  },
  "settings": {
    "keys": "ctrl+,",
    "keys_macos": "cmd+,",
    "description": "Open settings"
  },
  "quit": {
    "keys": "ctrl+q",
    "keys_macos": "cmd+q",
    "description": "Quit Chrome"
  },
  "select_all": {
    "keys": "ctrl+a",
    "keys_macos": "cmd+a",
    "description": "Select all"
  },
  "copy": {
    "keys": "ctrl+c",
    "keys_macos": "cmd+c",
    "description": "Copy"
  },
  "paste": {
    "keys": "ctrl+v",
    "keys_macos": "cmd+v",
    "description": "Paste"
  },
  "cut": {
    "keys": "ctrl+x",
    "keys_macos": "cmd+x",
    "description": "Cut"
  },
  "undo": {
    "keys": "ctrl+z",
    "keys_macos": "cmd+z",
    "description": "Undo"
  },
  "redo": {
    "keys": "ctrl+shift+z",
    "keys_macos": "cmd+shift+z",
    "description": "Redo"
  },
  "next_tab": {
    "keys": "ctrl+tab",
    "keys_macos": "cmd+tab",
    "description": "Next tab"
  },
  "prev_tab": {
    "keys": "ctrl+shift+tab",
    "keys_macos": "cmd+shift+tab",
    "description": "Previous tab"
  },
  "fullscreen": {
    "keys": "f11",
    "description": "Toggle fullscreen"
  },
  "view_source": {
    "keys": "ctrl+u",
    "keys_macos": "cmd+u",
    "description": "View page source"
  }
