{
  "profile_id": "firefox",
  "app_name": "Firefox",
  "type": "semantic",
  "backend": "atspi",
  "platform_hint": "linux",
  "notes": "Firefox profile using keyboard shortcuts (cross-platform) + AT-SPI for Linux-specific elements",
  "shortcuts": {
    "new_tab": {
      "keys": "ctrl+t",
      "keys_macos": "cmd+t",
      "description": "Open new tab"
    },
    "close_tab": {
      "keys": "ctrl+w",
      "keys_macos": "cmd+w",
      "description": "Close current tab"
    },
    "new_window": {
      "keys": "ctrl+n",
      "keys_macos": "cmd+n",
      "description": "Open new window"
    },
    "open_file": {
      "keys": "ctrl+o",
      "keys_macos": "cmd+o",
      "description": "Open file dialog"
    },
    "save_page": {
      "keys": "ctrl+s",
      "keys_macos": "cmd+s",
      "description": "Save current page"
    },
    "find": {
      "keys": "ctrl+f",
      "keys_macos": "cmd+f",
      "description": "Find in page"
    },
    "url_bar": {
      "keys": "ctrl+l",
      "keys_macos": "cmd+l",
      "description": "Focus URL bar"
    },
    "reload": {
      "keys": "f5",
      "description": "Reload page"
    },
    "back": {
      "keys": "alt+left",
      "keys_macos": "ctrl+left",
      "description": "Navigate back"
    },
    "forward": {
      "keys": "alt+right",
      "keys_macos": "ctrl+right",
      "description": "Navigate forward"
    },
    "zoom_in": {
      "keys": "ctrl+plus",
      "keys_macos": "cmd+plus",
      "description": "Zoom in"
    },
    "zoom_out": {
      "keys": "ctrl+minus",
      "keys_macos": "cmd+minus",
      "description": "Zoom out"
    },
    "bookmark": {
      "keys": "ctrl+d",
      "keys_macos": "cmd+d",
      "description": "Bookmark page"
    },
    "history": {
      "keys": "ctrl+h",
      "keys_macos": "cmd+h",
      "description": "Show history sidebar"
    },
    "downloads": {
      "keys": "ctrl+j",
      "keys_macos": "cmd+j",
      "description": "Show downloads"
    },
    "quit": {
      "keys": "ctrl+q",
      "keys_macos": "cmd+q",
      "description": "Quit Firefox"
    },
    "devtools": {
      "keys": "f12",
      "description": "Toggle developer tools"
    },
    "print": {
      "keys": "ctrl+p",
      "keys_macos": "cmd+p",
      "description": "Print page"
    },
    "select_all": {
      "keys": "ctrl+a",
      "keys_macos": "cmd+a",
      "description": "Select all"
    },
    "copy": {
      "keys": "ctrl+c",
      "keys_macos": "cmd+c",
      "description": "Copy selection"
    },
    "paste": {
      "keys": "ctrl+v",
      "keys_macos": "cmd+v",
      "description": "Paste"
    },
    "cut": {
      "keys": "ctrl+x",
      "keys_macos": "cmd+x",
      "description": "Cut selection"
    },
    "undo": {
      "keys": "ctrl+z",
      "keys_macos": "cmd+z",
      "description": "Undo"
    },
    "redo": {
      "keys": "ctrl+shift+z",
      "keys_macos": "cmd+shift+z",
      "description": "Redo"
    },
    "next_tab": {
      "keys": "ctrl+tab",
      "keys_macos": "cmd+tab",
      "description": "Switch to next tab"
    },
    "prev_tab": {
      "keys": "ctrl+shift+tab",
      "keys_macos": "cmd+shift+tab",
      "description": "Switch to previous tab"
    },
    "fullscreen": {
      "keys": "f11",
      "description": "Toggle fullscreen"
    }
