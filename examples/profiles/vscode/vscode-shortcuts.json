{
  "new_file": {
    "keys": "ctrl+n",
    "keys_macos": "cmd+n",
    "description": "New file"
  },
  "open_file": {
    "keys": "ctrl+o",
    "keys_macos": "cmd+o",
    "description": "Open file"
  },
